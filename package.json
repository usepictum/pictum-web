{
	"name": "@pictum/web",
	"type": "module",
	"types": "./dist/index.d.ts",
	"version": "0.1.0",
	"packageManager": "pnpm@11.11.0",
	"description": "Pictum asset custom elements.",
	"author": "Nicolas Hedger <nicolas@hedger.ch>",
	"license": "MIT",
	"homepage": "https://github.com/usepictum/pictum-web#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/usepictum/pictum-web.git"
	},
	"bugs": {
		"url": "https://github.com/usepictum/pictum-web/issues"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"dev": "tsdown --watch",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"play": "pnpm build && pnpm --filter @pictum/playground-web dev",
		"test": "vitest --run",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "pnpm build"
	},
	"dependencies": {
		"pictum": "^0.1.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@tsconfig/strictest": "^2.0.8",
		"@vitest/browser-playwright": "^4.1.10",
		"git-cliff": "2.13.1",
		"playwright": "^1.62.1",
		"tsdown": "^0.22.5",
		"typescript": "^7.0.2",
		"vite": "^8.1.4",
		"vitest": "^4.1.10"
	}
}
